# Haus-Cockpit – ENV-Vorlage.
# In Coolify als "Environment Variables" eintragen (NICHT committen – .env ist in .gitignore).

# Adresse deines Home Assistant. Für "von überall" die Nabu-Casa-Fernadresse nutzen:
#   https://<deine-id>.ui.nabu.casa
# Läuft die App im selben Netz wie HA, geht auch: http://192.168.178.128:8123
HA_URL=https://DEINE-ID.ui.nabu.casa

# Langlebiger Zugriffs-Token aus Home Assistant.
# In HA erstellen: Profil (unten links) -> Sicherheit -> "Langlebige Zugriffs-Tokens" -> Erstellen.
# Diesen Wert NUR hier in Coolify eintragen – er bleibt serverseitig und geht nie an den Browser.
HA_TOKEN=eyJ...dein-token...

# Passwort, mit dem sich die Familie in der App anmeldet.
HAUS_PASSWORD=bitte-aendern
